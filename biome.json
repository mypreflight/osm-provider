{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**/*",
      "features/**/*",
      "scripts/**/*",
      "*.json",
      "!**/dist",
      "!**/node_modules",
      "!package-lock.json",
      "!openapi.json"
    ]
  },
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "json": {},
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}

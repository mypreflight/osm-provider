{
  "name": "osm-airport-pull",
  "version": "1.1.1",
  "description": "OpenStreetMap airport infrastructure, deployed as a DigitalOcean Function",
  "author": "oskarbarcz",
  "license": "Unlicense",
  "main": "lib/function.js",
  "scripts": {
    "build": "./build.sh",
    "bundle": "esbuild src/lambda.ts --bundle --platform=node --target=node24 --format=cjs --keep-names --outfile=dist/lambda.js",
    "start:dev": "TS_NODE_PROJECT=tsconfig.tests.json node --watch -r ts-node/register scripts/dev-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "jest",
    "test:functional": "TS_NODE_PROJECT=tsconfig.tests.json cucumber-js --require-module ts-node/register/transpile-only --require 'features/_context/**/*.ts' --fail-fast"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cucumber/cucumber": "^13.3.0",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "expect": "^30.5.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob@>=9.0.0 <14.0.2": "^14.0.4"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false
  }
}

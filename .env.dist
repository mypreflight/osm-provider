# Base URL of the Flight Tracker API
API_BASE_URL=https://api.flights.barcz.me

# Credentials for a user with the "operations" role (required to write airport data)
FLIGHTS_EMAIL=operations@example.com
FLIGHTS_PASSWORD=changeme

# Overpass API endpoint(s) used to extract OpenStreetMap aeroway data.
# Optional: comma-separated list, tried in order until one responds.
# Leave unset to use the built-in list of public mirrors.
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# User-Agent sent to the Overpass API (required by its usage policy)
OSM_USER_AGENT=flight-tracker-airport-details (https://api.flights.barcz.me)
